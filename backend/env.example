# Spotube Environment Configuration (Echo Stack)
# Copy this file to .env and update with your actual values

# Application Environment
APP_ENV=development
VERSION=dev

# Server Configuration
PORT=8090
# Backend OAuth callbacks — must match provider console redirect URIs exactly.
# Can be http://127.0.0.1:8090 or http://localhost:8090 (pick one; do not mix).
PUBLIC_URL=http://localhost:8090

# Where you open the app in the browser. Keep localhost for Vite dev (not 127.0.0.1).
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173

# Database
DB_PATH=./data/spotube.db

# Logging
LOG_LEVEL=debug

# Background mapping sync (analysis + optional auto executor). Off by default for safe local dev.
SYNC_WORKERS_ENABLED=false

# Analysis cron (6-field: sec min hour dom month dow). Default: every minute at :00.
# Examples: "0 */5 * * * *" = every 5 min; "0 0 * * * *" = hourly
SYNC_ANALYSIS_CRON_SPEC=0 * * * * *

# Auto executor cron (RFC-008 batch worker). Keep false for manual per-item execution (V1).
SYNC_EXECUTOR_AUTO_ENABLED=false
SYNC_EXECUTOR_CRON_SPEC=*/10 * * * * *

# Session Configuration  
SESSION_COOKIE_NAME=spotube_session
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_TTL_SECONDS=2592000
SESSION_SECURE=false

# OAuth Credentials (optional - can be configured via setup wizard UI)
# Spotify Developer Console: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret 