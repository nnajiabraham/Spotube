# Spotube Environment Configuration (Echo Stack)
# Copy this file to .env and update with your actual values

# Application Environment
APP_ENV=development
VERSION=dev

# Server Configuration
PORT=8090
PUBLIC_URL=http://localhost:8090
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173

# Database
DB_PATH=./data/spotube.db

# Logging
LOG_LEVEL=debug

# Session Configuration  
SESSION_COOKIE_NAME=spotube_session
SESSION_SECRET=change-me-to-a-random-hex-string
SESSION_TTL_SECONDS=2592000
SESSION_SECURE=false

# OAuth Credentials (optional - can be configured via setup wizard UI)
# Spotify Developer Console: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret 