# Spotube Environment Configuration (Echo Stack)
# Copy this file to .env and update with your actual values

# Application Environment
APP_ENV=development
VERSION=dev

# Server Configuration
PORT=8090
# Backend OAuth callbacks — must match provider console redirect URIs exactly.
# Spotify only accepts loopback IPs (not "localhost"), so use 127.0.0.1 everywhere.
PUBLIC_URL=http://127.0.0.1:8090

# Where you open the app in the browser (Vite listens on all interfaces).
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Database
DB_PATH=./data/spotube.db

# Logging
LOG_LEVEL=debug

# Runtime settings. The four below are also on the Settings page (/settings). When set here,
# this value is used at startup and the page's changes last only until the next restart. Leave
# one unset (comment it out) to manage it from the page instead; the page then saves it in the
# database.

# Background sync: run each mapping on its schedule. Off by default for safe local dev;
# "Sync now" on the Mappings page works either way.
SYNC_WORKERS_ENABLED=false

# Apply queued items (add tracks / rename) automatically, across all mappings, within the
# YouTube quota budget. Set false to review the Sync Queue and execute items by hand instead.
SYNC_EXECUTOR_AUTO_ENABLED=true

# Scheduled playlist backups (each backup's own interval, checked every 10 minutes). Independent
# of SYNC_WORKERS_ENABLED; "Back up now" works either way.
BACKUPS_ENABLED=true

# YouTube Data API units per day for your Google Cloud project (10000 unless Google raised it).
# YOUTUBE_DAILY_QUOTA=10000

# Scheduler tick (6-field: sec min hour dom month dow). Each mapping still runs on its own
# schedule. Default: every minute at :00. Startup only.
SYNC_ANALYSIS_CRON_SPEC=0 * * * * *

# Session Configuration  
SESSION_COOKIE_NAME=spotube_session
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_TTL_SECONDS=2592000
SESSION_SECURE=false

# OAuth Credentials (optional - can be configured via setup wizard UI)
# Spotify Developer Console: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret 