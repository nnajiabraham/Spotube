# Spotube Environment Configuration (Echo Stack)
# Copy this file to .env and update with your actual values

# Application Environment
APP_ENV=development
VERSION=dev

# Server Configuration
PORT=8090
# Backend OAuth callbacks — must match provider console redirect URIs exactly.
# Spotify only accepts loopback IPs (not "localhost"), so use 127.0.0.1 everywhere.
PUBLIC_URL=http://127.0.0.1:8090

# Where you open the app in the browser (Vite listens on all interfaces).
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Database
DB_PATH=./data/spotube.db

# Logging
LOG_LEVEL=debug

# Scheduled sync. Off by default for safe local dev; "Sync now" on the Mappings page works either way.
SYNC_WORKERS_ENABLED=false

# Scheduler tick (6-field: sec min hour dom month dow). Each mapping still waits its own
# interval_minutes between runs. Default: every minute at :00.
SYNC_ANALYSIS_CRON_SPEC=0 * * * * *

# Apply queued items (add tracks / rename) right after analysis. Set false to review the
# Sync Queue and execute items by hand instead.
SYNC_EXECUTOR_AUTO_ENABLED=true

# Session Configuration  
SESSION_COOKIE_NAME=spotube_session
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_TTL_SECONDS=2592000
SESSION_SECURE=false

# OAuth Credentials (optional - can be configured via setup wizard UI)
# Spotify Developer Console: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret 